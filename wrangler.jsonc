{
  // LcinoCare landing site — deployed as a Cloudflare Worker with static assets.
  // Workers Builds runs `npx wrangler deploy` on every push to main.
  "name": "lcino-care-site",
  "compatibility_date": "2026-10-25",
  "assets": {
    // only the public/ folder is served — keeps .git and configs out
    "directory": "./public"
  }
}
